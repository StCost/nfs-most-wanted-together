// File details of MWTogether.asi (Explorer: Properties > Details). build.bat passes the release number:
// MWT_VERSION_STR and MWT_VERSION_NUM come from MWT_VERSION (the same number as the release).
#include <winver.h>

#ifndef MWT_VERSION_STR
#define MWT_VERSION_STR "0.0.0-dev"
#endif
#ifndef MWT_VERSION_NUM
#define MWT_VERSION_NUM 0,0,0,0
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MWT_VERSION_NUM
 PRODUCTVERSION MWT_VERSION_NUM
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "StCost"
            VALUE "FileDescription", "NFS Most Wanted Together: co-op mod plugin for Need for Speed: Most Wanted (2005), loaded by the Ultimate ASI Loader"
            VALUE "FileVersion", MWT_VERSION_STR
            VALUE "InternalName", "MWTogether"
            VALUE "LegalCopyright", "Copyright (c) 2026 StCost, MIT License"
            VALUE "OriginalFilename", "MWTogether.asi"
            VALUE "ProductName", "NFS Most Wanted Together"
            VALUE "ProductVersion", MWT_VERSION_STR
            VALUE "Comments", "https://github.com/StCost/nfs-most-wanted-together"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// asInvoker, uiAccess=false. Embedded here so the linker does not add a second manifest.
1 24 "MWTogether.manifest"

// The files the release used to ship next to the plugin, built in as they are (no packing or
// encryption, see resutil.h): the menu logo, the default settings, and the license texts.
MWT_LOGO        RCDATA "..\\assets\\MWTogether-logo.dds"
MWT_DEFAULT_INI RCDATA "..\\MWTogether.ini"
MWT_LICENSE     RCDATA "..\\LICENSE"
MWT_NOTICES     RCDATA "..\\THIRD-PARTY-NOTICES.txt"
